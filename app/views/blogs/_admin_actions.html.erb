  
<% if authorized_to %>
  <nav class="breadcrumb blogcrumb">
    <%= render partial: "blogs/status_toggle", locals: { blog: blog } %>
    <%= link_to fa_icon('pencil-square-o'), edit_blog_path(blog) %>
    <%= link_to fa_icon('trash'), blog, data: { turbo_method: :delete,
                        turbo_confirm: 'Are you sure?' } %>
  </nav>
<% end %>